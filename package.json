{
  "name": "football-academy-management",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev-refresh.cjs",
    "dev:turbo": "node scripts/dev-refresh.cjs --turbo",
    "ports:free": "node scripts/dev-refresh.cjs --free-only",
    "dev:simple": "next dev -p 3001",
    "dev:clean": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(e){}\" && next dev -p 3001",
    "clean": "node scripts/clean-next.cjs",
    "build:clean": "npm run clean && npm run build",
    "start:fresh": "npm run build:clean && next start -p 3001",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "check": "npm run lint && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install",
    "db:setup": "node scripts/apply-schema.cjs",
    "db:setup:supabase": "node scripts/setup-supabase.cjs",
    "db:setup:mysql": "node scripts/apply-schema-mysql.cjs",
    "db:verify": "node scripts/verify-supabase.cjs",
    "db:verify:mongodb": "node scripts/verify-mongodb.cjs",
    "db:connect": "node scripts/verify-mongodb.cjs",
    "db:postgres:install": "bash scripts/install-postgres-ubuntu.sh",
    "db:seed:invoice-demos": "node scripts/apply-seed-invoice-demos.cjs",
    "db:migrate:integrity": "node scripts/apply-integrity-migration.cjs",
    "db:migrate:registration-profile": "node scripts/apply-registration-profile-migration.cjs",
    "db:compose:up": "docker compose up -d",
    "db:compose:mongodb": "docker compose up -d mongodb",
    "db:compose:mysql": "docker compose up -d mysql",
    "db:compose:down": "docker compose down",
    "hostinger:setup": "bash scripts/hostinger-setup-all.sh",
    "db:clean:local": "node scripts/clean-local-testing-data.cjs",
    "env:init": "node scripts/init-local-env.cjs",
    "build:nationalities": "node scripts/build-nationality-allowlist.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.0",
    "@tiptap/extension-image": "^3.22.3",
    "@tiptap/extension-link": "^3.22.3",
    "@tiptap/extension-placeholder": "^3.22.3",
    "@tiptap/extension-underline": "^3.22.3",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "html-to-image": "^1.11.13",
    "isomorphic-dompurify": "^3.8.0",
    "leaflet": "^1.9.4",
    "mongoose": "^9.6.3",
    "mysql2": "^3.22.4",
    "next": "^15.3.0",
    "pdf-lib": "^1.17.1",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "resend": "^4.4.1",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.23.0",
    "eslint-config-next": "^15.3.0",
    "mongodb-memory-server": "^11.2.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.2",
    "vitest": "^3.2.4",
    "world-countries": "^5.1.0"
  }
}
