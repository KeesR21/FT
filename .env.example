# Local `npm run start` after build (optional). Dev server is always :3001 for this project.
PORT=3001

NEXT_PUBLIC_APP_NAME=Lion Football Academy

# --- Database (pick one) ---
# Priority when USE_MOCK_DB is not "true": DATABASE_URL (direct Postgres) > Supabase > in-memory mock.
#
# If every page shows: connect ECONNREFUSED 127.0.0.1:5432 — nothing is listening on Postgres.
# Fix one of:
#   A) Start Docker Postgres: npm run db:compose:up  then  npm run db:setup  (keep DATABASE_URL set, USE_MOCK_DB empty)
#   B) Use in-memory mock: USE_MOCK_DB=true  (comment out DATABASE_URL so you do not hit localhost by mistake)
#   C) Use hosted Supabase only: leave DATABASE_URL empty; set NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY
#
# Optional: insert Leo Niyonkuru + Noah Hategekimana (invoice-eligible) into Postgres:
#   npm run db:seed:invoice-demos
#
# Local Docker:
#   DATABASE_URL=postgresql://academy:academy@127.0.0.1:5432/academy
# Hosted (Neon/Railway): paste the pooled connection string; add ?sslmode=require if your provider needs it.
DATABASE_URL=

# true = in-memory store (no Docker/Postgres). Use for offline UI or when DATABASE_URL host is down.
USE_MOCK_DB=

# Optional: Supabase client API — only used if DATABASE_URL is not set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
EMAIL_FROM=academy@yourdomain.com
JWT_SECRET=replace-with-strong-secret
ADMIN_EMAIL=admin@ftprlions.com
ADMIN_PASSWORD=admin123
NOTIFICATIONS_CRON_SECRET=change-me
MONTHLY_FEE_AMOUNT=45000
REGISTRATION_FEE_AMOUNT=20000
PAYMENT_CURRENCY=RWF

# Maps use free OpenStreetMap + Leaflet (no key). Admin place search uses Nominatim via /api/geocode.
