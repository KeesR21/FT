# Hostinger / restricted hosting: never run dependency postinstall scripts.
# The native binaries we need (Next SWC, lightningcss, sharp) ship as
# prebuilt platform packages — they do NOT require postinstall compilation.
# This avoids EACCES / code 126 / code 127 errors during `npm install`.
ignore-scripts=true

# mongodb-memory-server is dev-only and must never download a binary in prod.
MONGOMS_DISABLE_POSTINSTALL=1

# Do not fail install due to engine version warnings (treat as non-fatal).
engine-strict=false

# Suppress telemetry prompt during build.
next_telemetry_disabled=1
