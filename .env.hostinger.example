# Copy to .env.local on your Hostinger VPS:
#   cp .env.hostinger.example .env.local
#   nano .env.local

PORT=3000
NODE_ENV=production

NEXT_PUBLIC_APP_NAME=Lion Football Academy

# --- MySQL (create in hPanel → Databases → MySQL) ---
USE_MOCK_DB=false
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@localhost:3306/DB_NAME

# --- Admin login ---
ADMIN_EMAIL=admin@ftprlions.com
ADMIN_PASSWORD=change-this-password
JWT_SECRET=generate-a-long-random-string-here

# --- Email ---
EMAIL_FROM=info@ftprlionsacademy.com
CONTACT_EMAIL=info@ftprlionsacademy.com
RESEND_API_KEY=

# --- Billing ---
MONTHLY_FEE_AMOUNT=45000
REGISTRATION_FEE_AMOUNT=20000
PAYMENT_CURRENCY=RWF
NOTIFICATIONS_CRON_SECRET=change-me-cron
