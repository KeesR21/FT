# =============================================================================
#  FTPR Lions Academy — Hostinger VPS Environment Variables
#  Steps:
#    1. SSH into your VPS:  ssh root@YOUR_VPS_IP
#    2. Copy this file:     cp .env.hostinger.example .env.local
#    3. Edit values:        nano .env.local
#    4. Build & start:      npm run build && pm2 start ecosystem.config.js
# =============================================================================

PORT=3000
NODE_ENV=production

NEXT_PUBLIC_APP_NAME=Lion Football Academy

# =============================================================================
#  DATABASE — MongoDB Atlas (free tier, no VPS installation needed)
#  1. Go to https://cloud.mongodb.com and sign up free
#  2. Create a cluster → Connect → Drivers → copy the connection string
#  3. Replace <username>, <password>, and <cluster-url> below
#  4. Under Network Access, add 0.0.0.0/0 (allow from anywhere)
# =============================================================================
USE_MOCK_DB=false
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/ftpr-lions?retryWrites=true&w=majority
MONGODB_DEV_MEMORY=false

# =============================================================================
#  ADMIN LOGIN
# =============================================================================
ADMIN_EMAIL=admin@ftprlions.com
ADMIN_PASSWORD=change-this-strong-password
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=generate-a-long-random-string-here

# =============================================================================
#  EMAIL — Resend (https://resend.com — free 3,000 emails/month)
#  1. Sign up at resend.com → add domain ftprlionsacademy.com → get API key
#  2. Set EMAIL_FROM to your verified domain address
# =============================================================================
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=info@ftprlionsacademy.com
CONTACT_EMAIL=info@ftprlionsacademy.com

# =============================================================================
#  BILLING
# =============================================================================
MONTHLY_FEE_AMOUNT=45000
REGISTRATION_FEE_AMOUNT=20000
PAYMENT_CURRENCY=RWF
NOTIFICATIONS_CRON_SECRET=change-me-cron
